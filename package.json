{
  "name": "discog-review-log",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "prepare": "bun scripts/install-git-hooks.mjs",
    "check": "biome check .",
    "check:ci": "biome ci .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "knip": "knip",
    "dev:web": "bun run --cwd apps/web dev",
    "build:web": "bun run --cwd apps/web build",
    "validate": "bun run check:ci && bun run typecheck && bun run test && bun run build:web && bun run knip"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@types/node": "^22.19.17",
    "fast-check": "4.7.0",
    "knip": "6.11.0",
    "lefthook": "2.1.6",
    "typescript": "6.0.3",
    "vitest": "4.1.5"
  }
}
