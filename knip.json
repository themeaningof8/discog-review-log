{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["src/index.ts"],
  "project": ["src/**/*.ts", "scripts/**/*.mjs"],
  "workspaces": {
    "apps/api": {
      "entry": ["index.ts"],
      "project": ["src/**/*.ts", "index.ts"]
    },
    "apps/web": {
      "entry": ["astro.config.mjs"],
      "project": ["src/**/*.astro", "src/**/*.tsx", "src/**/*.css"],
      "ignoreDependencies": ["tailwindcss"]
    }
  }
}
